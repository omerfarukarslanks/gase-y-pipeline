# ===========================================
# Gase-Y Pipeline - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ---- Database ----
POSTGRES_USER=gasey
POSTGRES_PASSWORD=gasey_secret
POSTGRES_DB=gasey_pipeline
DATABASE_URL=postgresql+asyncpg://gasey:gasey_secret@db:5432/gasey_pipeline

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- App ----
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ---- AI Providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- TTS Providers ----
ELEVENLABS_API_KEY=
GOOGLE_TTS_CREDENTIALS_PATH=

# ---- Image Providers ----
STABILITY_API_KEY=

# ---- Translation ----
DEEPL_API_KEY=

# ---- YouTube OAuth2 ----
YOUTUBE_CLIENT_ID=774656483317-jc7pg4v8v9c6ifm8if2bc209o343385o.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=**R5WI
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/platforms/youtube/callback

# ---- Instagram (Meta Graph API) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Twitter/X ----
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ---- Reddit ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- TikTok ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Storage (S3/MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gasey-media
S3_REGION=us-east-1

# ---- Media ----
MEDIA_DIR=/app/media
